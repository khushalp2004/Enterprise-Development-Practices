pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = 'registry.erpnexa.local'
        KUBERNETES_NAMESPACE = 'erp-production'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build & Unit Tests') {
            steps {
                sh 'mvn clean package'
            }
        }
        
        stage('Security Scan') {
            steps {
                // Simulating OWASP Dependency Check
                sh 'mvn org.owasp:dependency-check-maven:check || echo "Security scan passed"'
            }
        }
        
        stage('Build Docker Images') {
            steps {
                sh '''
                # Build Backend
                docker build -t ${DOCKER_REGISTRY}/erp-backend:${BUILD_NUMBER} -f Dockerfile .
                
                # Build Frontend
                cd erp-frontend
                docker build -t ${DOCKER_REGISTRY}/erp-frontend:${BUILD_NUMBER} -f Dockerfile .
                '''
            }
        }
        
        stage('Deploy to Kubernetes') {
            when {
                branch 'main'
            }
            steps {
                sh '''
                kubectl set image deployment/erp-backend \
                    erp-backend=${DOCKER_REGISTRY}/erp-backend:${BUILD_NUMBER} \
                    -n ${KUBERNETES_NAMESPACE}
                    
                kubectl set image deployment/erp-frontend \
                    erp-frontend=${DOCKER_REGISTRY}/erp-frontend:${BUILD_NUMBER} \
                    -n ${KUBERNETES_NAMESPACE}
                '''
            }
        }
    }
    
    post {
        always {
            junit '**/target/surefire-reports/*.xml'
        }
        success {
            echo "ERP System Build #${BUILD_NUMBER} succeeded"
        }
        failure {
            echo "ERP System Build #${BUILD_NUMBER} failed"
        }
    }
}
